{
  "name": "topgun",
  "version": "2.0.0",
  "description": "Evolution-strategy training arena: two neural agents in a procedural 3D combat simulation with live visualization",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "evolution-strategies",
    "neural-network",
    "game-ai",
    "threejs",
    "simulation",
    "machine-learning"
  ],
  "scripts": {
    "dev": "concurrently -n vite,train -c blue,green \"vite\" \"node server/index.js\"",
    "dev:ui": "vite",
    "train": "node server/index.js",
    "build": "vite build",
    "build:pages": "vite build",
    "export:demo": "node scripts/export-demo.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-chart-matrix": "^3.0.4",
    "three": "^0.172.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
